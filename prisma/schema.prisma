generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RoleType {
  dev
  devops
  qa
  data
  design
  product
  project
  tl
  sre
  seo
  content
}

enum Seniority {
  L1
  L2
  L3
  L4
  L5
}

enum Region {
  emea
  na
}

enum Currency {
  USD
  GBP
  EUR
}

enum ContractStatus {
  active
  paused
  closed
}

enum DeclarationStatus {
  draft
  confirmed
}

enum HourType {
  monthly
  total
}

enum ContractType {
  base
  change_order
  extension
}

enum SyncSource {
  jira_na
  manual
  api
}

enum NonBillableType {
  shared_ceremony
  leave
  internal_meeting
  training
  company
}

enum AlertLevel {
  safe
  watch
  warning
  critical
}

enum AnomalyFlagType {
  spike
  underuse
  pace_risk
  underburn_risk
  role_substitution
  missing_data
}

enum AnomalySeverity {
  low
  medium
  high
}

enum SuggestionType {
  declaration_adjustment
  pto_capacity_warning
  ceremony_overhead
  nonbillable_trend
}

enum SuggestionStatus {
  open
  acknowledged
  applied
  dismissed
}

enum NbMappingSource {
  jira_na
}

enum NbIdentifierType {
  issue_key
  account_key
  component_key
}

// ─── Workforce ────────────────────────────────────────────────────────────────

model Squad {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(120)
  leadPersonId Int?     @map("lead_person_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  lead         Person?                            @relation("SquadLead", fields: [leadPersonId], references: [id])
  members      SquadMembership[]
  declarations MonthlyRoleDeclaration[]
  suggestions  NonBillableEnhancementSuggestion[]
  anomalyFlags AnomalyFlag[]
  HourRecord   HourRecord[]

  @@map("squads")
}

model Person {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(200)
  email               String   @unique @db.VarChar(200)
  isActive            Boolean  @default(true) @map("is_active")
  weeklyCapacityHours Decimal  @default(40.00) @map("weekly_capacity_hours") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  leadSquads       Squad[]                            @relation("SquadLead")
  squadMemberships SquadMembership[]
  roles            PersonRole[]
  hourRecords      HourRecord[]
  suggestions      NonBillableEnhancementSuggestion[]
  capacityHistory  PersonCapacityHistory[]

  @@map("persons")
}

model PersonCapacityHistory {
  id                  Int       @id @default(autoincrement())
  personId            Int       @map("person_id")
  weeklyCapacityHours Decimal   @map("weekly_capacity_hours") @db.Decimal(5, 2)
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, effectiveFrom])
  @@index([personId])
  @@map("person_capacity_history")
}

model SquadMembership {
  id            Int       @id @default(autoincrement())
  personId      Int       @map("person_id")
  squadId       Int       @map("squad_id")
  allocationPct Decimal   @default(1.0000) @map("allocation_pct") @db.Decimal(5, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  person Person @relation(fields: [personId], references: [id])
  squad  Squad  @relation(fields: [squadId], references: [id])

  @@unique([personId, squadId, effectiveFrom])
  @@index([squadId])
  @@map("squad_memberships")
}

model PersonRole {
  id            Int        @id @default(autoincrement())
  personId      Int        @map("person_id")
  roleType      RoleType   @map("role_type")
  seniority     Seniority?
  effectiveFrom DateTime   @map("effective_from") @db.Date
  effectiveTo   DateTime?  @map("effective_to") @db.Date

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, roleType, effectiveFrom])
  @@index([personId, roleType])
  @@map("person_roles")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  region    Region
  currency  Currency @default(USD)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sows         StatementOfWork[]
  hourRecords  HourRecord[]
  anomalyFlags AnomalyFlag[]
  declarations MonthlyRoleDeclaration[]

  @@map("clients")
}

// ─── Contracts ────────────────────────────────────────────────────────────────

model StatementOfWork {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(200)
  clientId    Int       @map("client_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  parentSowId Int?      @map("parent_sow_id")

  client    Client            @relation(fields: [clientId], references: [id])
  parentSow StatementOfWork?  @relation("SowHierarchy", fields: [parentSowId], references: [id], onDelete: SetNull)
  childSows StatementOfWork[] @relation("SowHierarchy")
  contracts Contract[]

  @@index([clientId])
  @@index([parentSowId])
  @@map("statements_of_work")
}

model Contract {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar(200)
  sowId            Int            @map("sow_id")
  hourType         HourType       @map("hour_type")
  type             ContractType
  assignedHours    Decimal        @map("assigned_hours") @db.Decimal(8, 2)
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  status           ContractStatus @default(active)
  parentContractId Int?           @map("parent_contract_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  sow            StatementOfWork              @relation(fields: [sowId], references: [id])
  parentContract Contract?                    @relation("ContractHierarchy", fields: [parentContractId], references: [id], onDelete: SetNull)
  childContracts Contract[]                   @relation("ContractHierarchy")
  declarations   MonthlyRoleDeclaration[]
  hourRecords    HourRecord[]
  jiraMappings   JiraComponentClientMapping[]

  @@index([sowId, status])
  @@index([parentContractId])
  @@map("contracts")
}

model MonthlyRoleDeclaration {
  id         Int               @id @default(autoincrement())
  contractId Int?              @map("contract_id")
  clientId   Int               @map("client_id")
  squadId    Int               @map("squad_id")
  month      DateTime          @db.Date
  status     DeclarationStatus @default(draft)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  contract Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  client   Client               @relation(fields: [clientId], references: [id])
  squad    Squad                @relation(fields: [squadId], references: [id])
  roles    DeclarationRoleEntry[]

  @@unique([contractId, month])
  @@index([clientId, month])
  @@index([squadId, month])
  @@index([clientId, month, status])
  @@map("monthly_role_declarations")
}

model DeclarationRoleEntry {
  id            Int      @id @default(autoincrement())
  declarationId Int      @map("declaration_id")
  roleType      RoleType @map("role_type")
  declaredHours Decimal  @map("declared_hours") @db.Decimal(8, 2)

  declaration MonthlyRoleDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@unique([declarationId, roleType])
  @@index([declarationId])
  @@map("declaration_role_entries")
}

// ─── Time Records ─────────────────────────────────────────────────────────────

model HourRecord {
  id                    Int        @id @default(autoincrement())
  personId              Int        @map("person_id")
  squadId               Int        @map("squad_id")
  clientId              Int?       @map("client_id")
  contractId            Int?       @map("contract_id")
  date                  DateTime   @db.Date
  hours                 Decimal    @db.Decimal(6, 2)
  roleType              RoleType?  @map("role_type")
  source                SyncSource
  isNonBillable         Boolean    @default(false) @map("is_non_billable")
  nonBillableCategoryId Int?       @map("nonbillable_category_id")
  externalRef           String?    @unique @map("external_ref") @db.VarChar(300)
  issueKey              String?    @map("issue_key") @db.VarChar(50)
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at")

  person              Person               @relation(fields: [personId], references: [id])
  squad               Squad                @relation(fields: [squadId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  contract            Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  nonBillableCategory NonBillableCategory? @relation(fields: [nonBillableCategoryId], references: [id])

  @@index([clientId, date])
  @@index([personId, date])
  @@index([squadId, date])
  @@index([roleType, date])
  @@index([clientId, date, isNonBillable])
  @@map("hour_records")
}

model NonBillableCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(120)
  type        NonBillableType
  description String?
  isActive    Boolean         @default(true) @map("is_active")

  hourRecords    HourRecord[]
  sourceMappings NonBillableSourceMapping[]

  @@map("nonbillable_categories")
}

model NonBillableSourceMapping {
  id              Int              @id @default(autoincrement())
  source          NbMappingSource
  identifierType  NbIdentifierType @map("identifier_type")
  identifierValue String           @map("identifier_value") @db.VarChar(200)
  categoryId      Int              @map("category_id")

  category NonBillableCategory @relation(fields: [categoryId], references: [id])

  @@unique([source, identifierValue])
  @@map("nonbillable_source_mappings")
}

model JiraComponentClientMapping {
  id            Int       @id @default(autoincrement())
  jiraInstance  String    @default("na") @map("jira_instance") @db.VarChar(10)
  componentKey  String    @map("component_key") @db.VarChar(200)
  contractId    Int       @map("contract_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([jiraInstance, componentKey, effectiveFrom])
  @@map("jira_component_client_mappings")
}

model SyncLog {
  id                Int        @id @default(autoincrement())
  source            SyncSource
  startedAt         DateTime   @map("started_at")
  completedAt       DateTime?  @map("completed_at")
  dateFrom          DateTime?  @map("date_from")
  dateTo            DateTime?  @map("date_to")
  recordsFetched    Int        @default(0) @map("records_fetched")
  recordsCreated    Int        @default(0) @map("records_created")
  recordsSkipped    Int        @default(0) @map("records_skipped")
  recordsConflicted Int        @default(0) @map("records_conflicted")

  @@index([source, startedAt])
  @@map("sync_logs")
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnomalyFlag {
  id              Int             @id @default(autoincrement())
  clientId        Int             @map("client_id")
  squadId         Int?            @map("squad_id")
  month           DateTime        @db.Date
  roleType        RoleType?       @map("role_type")
  flagType        AnomalyFlagType @map("flag_type")
  severity        AnomalySeverity
  detectorVersion String          @default("rules_v1") @map("detector_version") @db.VarChar(50)
  explanation     String?
  detectedAt      DateTime        @default(now()) @map("detected_at")
  resolvedAt      DateTime?       @map("resolved_at")
  resolvedBy      Int?            @map("resolved_by")
  resolutionNotes String?         @map("resolution_notes")

  client Client @relation(fields: [clientId], references: [id])
  squad  Squad? @relation(fields: [squadId], references: [id])

  @@unique([clientId, month, flagType, roleType, detectorVersion], name: "uq_anomaly_dedupe")
  @@index([clientId, month])
  @@map("anomaly_flags")
}

model NonBillableEnhancementSuggestion {
  id              Int              @id @default(autoincrement())
  personId        Int?             @map("person_id")
  squadId         Int?             @map("squad_id")
  month           DateTime         @db.Date
  suggestionType  SuggestionType   @map("suggestion_type")
  status          SuggestionStatus @default(open)
  explanation     String
  suggestedAction String           @map("suggested_action")
  suggestedHours  Decimal?         @map("suggested_hours") @db.Decimal(8, 2)
  currentHours    Decimal?         @map("current_hours") @db.Decimal(8, 2)
  detectedAt      DateTime         @default(now()) @map("detected_at")
  resolvedAt      DateTime?        @map("resolved_at")
  resolvedBy      Int?             @map("resolved_by")

  person Person? @relation(fields: [personId], references: [id])
  squad  Squad?  @relation(fields: [squadId], references: [id])

  @@index([month, status])
  @@map("nonbillable_enhancement_suggestions")
}

