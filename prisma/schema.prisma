generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RoleType {
  frontend_dev
  backend_dev
  fullstack_dev
  devops
  qa
  ux_designer
  product_manager
  project_manager
  tech_lead
  solutions_architect
  data_engineer
  scrum_master
  business_analyst
  seo
  content_author
  client_services
}

enum Seniority {
  L1
  L2
  L3
  L4
  L5
}

enum EmploymentType {
  dedicated
  shared
}

enum Region {
  emea
  na
}

enum Currency {
  USD
  GBP
  EUR
}

enum ContractStatus {
  active
  paused
  closed
}

enum DeclarationStatus {
  draft
  confirmed
  locked
  derived
}

enum ExtensionType {
  te
  co
}

enum ExtensionStatus {
  pending_approval
  approved
  rejected
  closed
}

enum ChangeOrderStatus {
  pending_written
  pending_docusign
  approved
  active
  closed
}

enum TEBillingType {
  same_rate
  premium_flat
  premium_pct
  blended_rate
  per_role
}

enum SMESource {
  internal_other_squad
  external_contractor
}

enum SMEStatus {
  requested
  confirmed
  active
  closed
}

enum SyncSource {
  tempo
  jira_na
  manual
  api
}

enum BudgetSource {
  retainer
  te
  change_order
  sme
}

enum NonBillableType {
  shared_ceremony
  leave
  internal_meeting
  training
  company
}

enum AlertLevel {
  safe
  watch
  warning
  critical
}

enum AnomalyFlagType {
  spike
  underuse
  pace_risk
  underburn_risk
  role_substitution
  missing_data
  cascade_violation
}

enum AnomalySeverity {
  low
  medium
  high
}

enum SuggestionType {
  declaration_adjustment
  pto_capacity_warning
  ceremony_overhead
  nonbillable_trend
}

enum SuggestionStatus {
  open
  acknowledged
  applied
  dismissed
}

enum SimulationAction {
  available
  hire_needed
  redistribute
}

// ─── Workforce ────────────────────────────────────────────────────────────────

model Squad {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(120)
  leadPersonId Int?     @map("lead_person_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  lead            Person?              @relation("SquadLead", fields: [leadPersonId], references: [id])
  members         SquadMembership[]
  capacityConfigs SquadCapacityConfig[]
  declarations    MonthlyRoleDeclaration[]
  changeOrders    ChangeOrder[]
  smeEngagements  SMEEngagement[]
  gapSnapshots    StaffingGapSnapshot[]
  ceremonyAttributions CeremonyAttribution[]
  ceremonyAllocations  MonthlyCeremonyAllocation[]
  nbSummaries     MonthlyNonBillableSummary[]
  suggestions     NonBillableEnhancementSuggestion[]
  anomalyFlags    AnomalyFlag[]
  retainerContracts RetainerContract[]

  @@map("squads")
}

model Person {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(200)
  email               String         @unique @db.VarChar(200)
  employmentType      EmploymentType @default(dedicated) @map("employment_type")
  isActive            Boolean        @default(true) @map("is_active")
  weeklyCapacityHours Decimal        @default(40.00) @map("weekly_capacity_hours") @db.Decimal(5, 2)
  tempoAccountId      String?        @unique @map("tempo_account_id") @db.VarChar(200)
  costPerHour         Decimal?       @map("cost_per_hour") @db.Decimal(8, 2)
  createdAt           DateTime       @default(now()) @map("created_at")

  ledSquads           Squad[]                  @relation("SquadLead")
  squadMemberships    SquadMembership[]
  roles               PersonRole[]
  clientAccess        ClientPersonAccess[]
  calendarAssignments PersonCalendarAssignment[]
  hourRecords         HourRecord[]
  nbEntries           NonBillableEntry[]
  nbSummaries         MonthlyNonBillableSummary[]
  suggestions         NonBillableEnhancementSuggestion[]
  ceremonyAllocations MonthlyCeremonyAllocation[]
  smeEngagements      SMEEngagement[]          @relation("SMEPerson")
  simulations         ClientSimulation[]       @relation("SimRequestedBy")

  @@map("persons")
}

model SquadMembership {
  id            Int      @id @default(autoincrement())
  personId      Int      @map("person_id")
  squadId       Int      @map("squad_id")
  allocationPct Decimal  @default(1.0000) @map("allocation_pct") @db.Decimal(5, 4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  person Person @relation(fields: [personId], references: [id])
  squad  Squad  @relation(fields: [squadId], references: [id])

  @@unique([personId, squadId, effectiveFrom])
  @@index([squadId])
  @@map("squad_memberships")
}

model PersonRole {
  id            Int       @id @default(autoincrement())
  personId      Int       @map("person_id")
  roleType      RoleType  @map("role_type")
  seniority     Seniority?
  isPrimary     Boolean   @default(true) @map("is_primary")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, roleType])
  @@map("person_roles")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  region    Region
  currency  Currency @default(USD)
  createdAt DateTime @default(now()) @map("created_at")

  personAccess         ClientPersonAccess[]
  billingRates         BillingRate[]
  retainerContracts    RetainerContract[]
  extensions           ContractExtension[]
  teBillingConfig      TEBillingConfig?
  changeOrders         ChangeOrder[]
  smeEngagements       SMEEngagement[]
  hourRecords          HourRecord[]
  consumptionSummaries MonthlyConsumptionSummary[]
  burnSnapshots        WeeklyBurnSnapshot[]
  ceremonyAttributions CeremonyAttribution[]
  ceremonyAllocations  MonthlyCeremonyAllocation[]
  anomalyFlags         AnomalyFlag[]
  declarations         MonthlyRoleDeclaration[]
  cascadeRules         RoleCascadeRule[]
  tempoMappings        TempoAccountClientMapping[]
  jiraMappings         JiraComponentClientMapping[]
  simulations          ClientSimulation[]

  @@map("clients")
}

model ClientPersonAccess {
  id        Int       @id @default(autoincrement())
  clientId  Int       @map("client_id")
  personId  Int       @map("person_id")
  grantedAt DateTime  @default(now()) @map("granted_at")
  grantedBy Int?      @map("granted_by")
  revokedAt DateTime? @map("revoked_at")

  client Client @relation(fields: [clientId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@unique([clientId, personId])
  @@map("client_person_access")
}

model SquadCapacityConfig {
  id             Int      @id @default(autoincrement())
  squadId        Int      @map("squad_id")
  roleType       RoleType @map("role_type")
  hardBufferPct  Decimal  @default(0.1500) @map("hard_buffer_pct") @db.Decimal(5, 4)
  softBufferPct  Decimal  @default(0.1000) @map("soft_buffer_pct") @db.Decimal(5, 4)

  squad Squad @relation(fields: [squadId], references: [id])

  @@unique([squadId, roleType])
  @@map("squad_capacity_configs")
}

model RoleCascadeRule {
  id            Int      @id @default(autoincrement())
  clientId      Int?     @map("client_id")
  triggerRole   RoleType @map("trigger_role")
  dependentRole RoleType @map("dependent_role")
  ratio         Decimal  @db.Decimal(5, 4)

  client Client? @relation(fields: [clientId], references: [id])

  @@unique([clientId, triggerRole, dependentRole])
  @@map("role_cascade_rules")
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model HolidayCalendar {
  id     Int    @id @default(autoincrement())
  region String @db.VarChar(50)
  name   String @db.VarChar(120)

  entries            HolidayEntry[]
  personAssignments  PersonCalendarAssignment[]

  @@map("holiday_calendars")
}

model HolidayEntry {
  id         Int      @id @default(autoincrement())
  calendarId Int      @map("calendar_id")
  date       DateTime @db.Date
  name       String   @db.VarChar(200)

  calendar HolidayCalendar @relation(fields: [calendarId], references: [id])

  @@unique([calendarId, date])
  @@map("holiday_entries")
}

model PersonCalendarAssignment {
  id            Int      @id @default(autoincrement())
  personId      Int      @map("person_id")
  calendarId    Int      @map("calendar_id")
  effectiveFrom DateTime @map("effective_from") @db.Date

  person   Person          @relation(fields: [personId], references: [id])
  calendar HolidayCalendar @relation(fields: [calendarId], references: [id])

  @@index([personId])
  @@map("person_calendar_assignments")
}

// ─── Contracts ────────────────────────────────────────────────────────────────

model RetainerContract {
  id             Int            @id @default(autoincrement())
  clientId       Int            @map("client_id")
  squadId        Int            @map("squad_id")
  totalPoolHours Decimal        @map("total_pool_hours") @db.Decimal(8, 2)
  status         ContractStatus @default(active)
  validFrom      DateTime       @map("valid_from") @db.Date
  validTo        DateTime?      @map("valid_to") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  client       Client                   @relation(fields: [clientId], references: [id])
  squad        Squad                    @relation(fields: [squadId], references: [id])
  declarations MonthlyRoleDeclaration[]

  @@index([clientId, status])
  @@map("retainer_contracts")
}

model MonthlyRoleDeclaration {
  id                   Int               @id @default(autoincrement())
  contractId           Int?              @map("contract_id")
  extensionId          Int?              @map("extension_id")
  clientId             Int               @map("client_id")
  squadId              Int               @map("squad_id")
  month                DateTime          @db.Date
  roleType             RoleType          @map("role_type")
  declaredHours        Decimal           @map("declared_hours") @db.Decimal(8, 2)
  status               DeclarationStatus @default(draft)
  submittedAt          DateTime?         @map("submitted_at")
  submittedBy          Int?              @map("submitted_by")
  changeFromPriorHours Decimal?          @map("change_from_prior_hours") @db.Decimal(8, 2)
  significantChangeFlag Boolean          @default(false) @map("significant_change_flag")
  lateChangeFlag       Boolean           @default(false) @map("late_change_flag")
  overrideReason       String?           @map("override_reason")
  overrideBy           Int?              @map("override_by")

  contract  RetainerContract?  @relation(fields: [contractId], references: [id])
  extension ContractExtension? @relation(fields: [extensionId], references: [id])
  client    Client             @relation(fields: [clientId], references: [id])
  squad     Squad              @relation(fields: [squadId], references: [id])

  @@index([clientId, month])
  @@index([squadId, month])
  @@index([contractId, month, roleType])
  @@index([extensionId, month, roleType])
  @@map("monthly_role_declarations")
}

model BillingRate {
  id            Int       @id @default(autoincrement())
  clientId      Int       @map("client_id")
  roleType      RoleType? @map("role_type")
  ratePerHour   Decimal   @map("rate_per_hour") @db.Decimal(10, 4)
  currency      Currency
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, roleType, effectiveFrom])
  @@map("billing_rates")
}

model CostRate {
  id            Int       @id @default(autoincrement())
  personId      Int?      @map("person_id")
  roleType      RoleType? @map("role_type")
  ratePerHour   Decimal   @map("rate_per_hour") @db.Decimal(10, 4)
  currency      Currency
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  @@unique([personId, roleType, effectiveFrom])
  @@map("cost_rates")
}

model TEBillingConfig {
  id       Int           @id @default(autoincrement())
  clientId Int           @unique @map("client_id")
  type     TEBillingType
  value    Decimal?      @db.Decimal(10, 4)
  currency Currency?

  client    Client            @relation(fields: [clientId], references: [id])
  roleRates TEBillingRoleRate[]

  @@map("te_billing_configs")
}

model TEBillingRoleRate {
  id               Int      @id @default(autoincrement())
  teBillingConfigId Int     @map("te_billing_config_id")
  roleType         RoleType @map("role_type")
  ratePerHour      Decimal  @map("rate_per_hour") @db.Decimal(10, 4)
  currency         Currency

  config TEBillingConfig @relation(fields: [teBillingConfigId], references: [id])

  @@unique([teBillingConfigId, roleType])
  @@map("te_billing_role_rates")
}

model ContractExtension {
  id             Int             @id @default(autoincrement())
  clientId       Int             @map("client_id")
  month          DateTime        @db.Date
  type           ExtensionType   @default(te)
  status         ExtensionStatus @default(pending_approval)
  requestedHours Decimal         @map("requested_hours") @db.Decimal(8, 2)
  roleType       RoleType?       @map("role_type")
  rateOverride   Decimal?        @map("rate_override") @db.Decimal(10, 4)
  approvedBy     Int?            @map("approved_by")
  approvedAt     DateTime?       @map("approved_at")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  client       Client                   @relation(fields: [clientId], references: [id])
  declarations MonthlyRoleDeclaration[]

  @@index([clientId, month])
  @@map("contract_extensions")
}

model ChangeOrder {
  id                  Int               @id @default(autoincrement())
  clientId            Int               @map("client_id")
  squadId             Int               @map("squad_id")
  dateRangeStart      DateTime          @map("date_range_start") @db.Date
  dateRangeEnd        DateTime          @map("date_range_end") @db.Date
  status              ChangeOrderStatus @default(pending_written)
  writtenApprovalRef  String?           @map("written_approval_ref") @db.VarChar(500)
  writtenApprovalAt   DateTime?         @map("written_approval_at")
  docusignEnvelopeId  String?           @map("docusign_envelope_id") @db.VarChar(200)
  docusignSignedAt    DateTime?         @map("docusign_signed_at")
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")

  client    Client                @relation(fields: [clientId], references: [id])
  squad     Squad                 @relation(fields: [squadId], references: [id])
  lineItems ChangeOrderLineItem[]

  @@map("change_orders")
}

model ChangeOrderLineItem {
  id            Int      @id @default(autoincrement())
  changeOrderId Int      @map("change_order_id")
  roleType      RoleType @map("role_type")
  hours         Decimal  @db.Decimal(8, 2)
  rateOverride  Decimal? @map("rate_override") @db.Decimal(10, 4)

  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id])

  @@unique([changeOrderId, roleType])
  @@map("change_order_line_items")
}

model SMEEngagement {
  id               Int       @id @default(autoincrement())
  clientId         Int       @map("client_id")
  squadId          Int       @map("squad_id")
  month            DateTime  @db.Date
  roleDescription  String    @map("role_description") @db.VarChar(200)
  source           SMESource
  personId         Int?      @map("person_id")
  contractedHours  Decimal   @map("contracted_hours") @db.Decimal(8, 2)
  costRate         Decimal   @map("cost_rate") @db.Decimal(10, 4)
  billingRate      Decimal   @map("billing_rate") @db.Decimal(10, 4)
  currency         Currency
  approvedBy       Int?      @map("approved_by")
  status           SMEStatus @default(requested)
  createdAt        DateTime  @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id])
  squad  Squad   @relation(fields: [squadId], references: [id])
  person Person? @relation("SMEPerson", fields: [personId], references: [id])

  @@map("sme_engagements")
}

// ─── Time Records ─────────────────────────────────────────────────────────────

model HourRecord {
  id                  Int          @id @default(autoincrement())
  personId            Int          @map("person_id")
  clientId            Int          @map("client_id")
  date                DateTime     @db.Date
  hours               Decimal      @db.Decimal(6, 2)
  roleType            RoleType     @map("role_type")
  source              SyncSource
  budgetSource        BudgetSource @default(retainer) @map("budget_source")
  contractExtensionId Int?         @map("contract_extension_id")
  changeOrderId       Int?         @map("change_order_id")
  smeEngagementId     Int?         @map("sme_engagement_id")
  externalRef         String?      @unique @map("external_ref") @db.VarChar(300)
  description         String?
  issueKey            String?      @map("issue_key") @db.VarChar(50)
  issueSummary        String?      @map("issue_summary")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, date])
  @@index([personId, date])
  @@index([roleType, date])
  @@map("hour_records")
}

model NonBillableCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(120)
  type        NonBillableType
  description String?

  entries         NonBillableEntry[]
  sourceMappings  NonBillableSourceMapping[]

  @@map("nonbillable_categories")
}

model NonBillableEntry {
  id          Int      @id @default(autoincrement())
  personId    Int      @map("person_id")
  squadId     Int      @map("squad_id")
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(6, 2)
  categoryId  Int      @map("category_id")
  notes       String?
  externalRef String?  @unique @map("external_ref") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  person   Person              @relation(fields: [personId], references: [id])
  category NonBillableCategory @relation(fields: [categoryId], references: [id])

  @@index([personId, date])
  @@index([squadId, date])
  @@map("nonbillable_entries")
}

model NonBillableSourceMapping {
  id              Int    @id @default(autoincrement())
  source          String @db.VarChar(20)
  identifierType  String @map("identifier_type") @db.VarChar(50)
  identifierValue String @map("identifier_value") @db.VarChar(200)
  categoryId      Int    @map("category_id")

  category NonBillableCategory @relation(fields: [categoryId], references: [id])

  @@unique([source, identifierValue])
  @@map("nonbillable_source_mappings")
}

model TempoAccountClientMapping {
  id            Int       @id @default(autoincrement())
  accountKey    String    @map("account_key") @db.VarChar(200)
  clientId      Int       @map("client_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  client Client @relation(fields: [clientId], references: [id])

  @@unique([accountKey, effectiveFrom])
  @@map("tempo_account_client_mappings")
}

model JiraComponentClientMapping {
  id             Int       @id @default(autoincrement())
  jiraInstance   String    @default("na") @map("jira_instance") @db.VarChar(10)
  componentKey   String    @map("component_key") @db.VarChar(200)
  clientId       Int       @map("client_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  client Client @relation(fields: [clientId], references: [id])

  @@unique([componentKey, effectiveFrom])
  @@map("jira_component_client_mappings")
}

model SyncLog {
  id                 Int        @id @default(autoincrement())
  source             SyncSource
  syncType           String     @map("sync_type") @db.VarChar(20)
  startedAt          DateTime   @map("started_at")
  completedAt        DateTime?  @map("completed_at")
  recordsFetched     Int        @default(0) @map("records_fetched")
  recordsCreated     Int        @default(0) @map("records_created")
  recordsSkipped     Int        @default(0) @map("records_skipped")
  recordsConflicted  Int        @default(0) @map("records_conflicted")
  errorMessage       String?    @map("error_message")
  unmappedRefs       String?    @map("unmapped_refs")

  @@map("sync_logs")
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model StaffingGapSnapshot {
  id                 Int      @id @default(autoincrement())
  squadId            Int      @map("squad_id")
  roleType           RoleType @map("role_type")
  month              DateTime @db.Date
  totalAvailableHours Decimal  @map("total_available_hours") @db.Decimal(8, 2)
  hardBufferHours    Decimal  @map("hard_buffer_hours") @db.Decimal(8, 2)
  softBufferHours    Decimal  @default(0) @map("soft_buffer_hours") @db.Decimal(8, 2)
  committedHours     Decimal  @map("committed_hours") @db.Decimal(8, 2)
  actualHours        Decimal  @default(0) @map("actual_hours") @db.Decimal(8, 2)
  unplannedHours     Decimal  @default(0) @map("unplanned_hours") @db.Decimal(8, 2)
  actualNbHours      Decimal  @default(0) @map("actual_nb_hours") @db.Decimal(8, 2)
  netGapHours        Decimal  @map("net_gap_hours") @db.Decimal(8, 2)
  commitmentRatio    Decimal  @map("commitment_ratio") @db.Decimal(6, 4)
  isUnderstaffed     Boolean  @default(false) @map("is_understaffed")
  isOverstaffed      Boolean  @default(false) @map("is_overstaffed")
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  squad Squad @relation(fields: [squadId], references: [id])

  @@unique([squadId, roleType, month])
  @@index([month])
  @@map("staffing_gap_snapshots")
}

model MonthlyConsumptionSummary {
  id                     Int       @id @default(autoincrement())
  clientId               Int       @map("client_id")
  month                  DateTime  @db.Date
  roleType               RoleType? @map("role_type")
  declaredHours          Decimal   @default(0) @map("declared_hours") @db.Decimal(8, 2)
  consumedHours          Decimal   @default(0) @map("consumed_hours") @db.Decimal(8, 2)
  retainerHours          Decimal   @default(0) @map("retainer_hours") @db.Decimal(8, 2)
  teHours                Decimal   @default(0) @map("te_hours") @db.Decimal(8, 2)
  coHours                Decimal   @default(0) @map("co_hours") @db.Decimal(8, 2)
  smeHours               Decimal   @default(0) @map("sme_hours") @db.Decimal(8, 2)
  remainingHours         Decimal   @default(0) @map("remaining_hours") @db.Decimal(8, 2)
  utilizationPct         Decimal   @default(0) @map("utilization_pct") @db.Decimal(6, 4)
  billedRevenue          Decimal?  @map("billed_revenue") @db.Decimal(12, 4)
  directCost             Decimal?  @map("direct_cost") @db.Decimal(12, 4)
  attributedCeremonyCost Decimal?  @map("attributed_ceremony_cost") @db.Decimal(12, 4)
  grossMargin            Decimal?  @map("gross_margin") @db.Decimal(12, 4)
  grossMarginPct         Decimal?  @map("gross_margin_pct") @db.Decimal(6, 4)
  lastRefreshed          DateTime  @default(now()) @map("last_refreshed")

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, month, roleType])
  @@index([clientId, month])
  @@map("monthly_consumption_summaries")
}

model WeeklyBurnSnapshot {
  id                     Int       @id @default(autoincrement())
  clientId               Int       @map("client_id")
  weekStart              DateTime  @map("week_start") @db.Date
  roleType               RoleType? @map("role_type")
  cumulativeHours        Decimal   @default(0) @map("cumulative_hours") @db.Decimal(8, 2)
  expectedCumulative     Decimal   @default(0) @map("expected_cumulative") @db.Decimal(8, 2)
  burnRateRatio          Decimal   @default(1) @map("burn_rate_ratio") @db.Decimal(6, 4)
  projectedEomHours      Decimal   @default(0) @map("projected_eom_hours") @db.Decimal(8, 2)
  poolHours              Decimal   @default(0) @map("pool_hours") @db.Decimal(8, 2)
  alertLevel             AlertLevel @default(safe) @map("alert_level")
  projectedExhaustionDate DateTime? @map("projected_exhaustion_date") @db.Date
  createdAt              DateTime   @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, weekStart, roleType])
  @@map("weekly_burn_snapshots")
}

model CeremonyAttribution {
  id                      Int      @id @default(autoincrement())
  squadId                 Int      @map("squad_id")
  clientId                Int      @map("client_id")
  month                   DateTime @db.Date
  squadTotalCeremonyHours Decimal  @map("squad_total_ceremony_hours") @db.Decimal(8, 2)
  clientActualHours       Decimal  @map("client_actual_hours") @db.Decimal(8, 2)
  squadTotalActualHours   Decimal  @map("squad_total_actual_hours") @db.Decimal(8, 2)
  attributionFraction     Decimal  @map("attribution_fraction") @db.Decimal(6, 4)
  attributedHours         Decimal  @map("attributed_hours") @db.Decimal(8, 2)
  costImpact              Decimal? @map("cost_impact") @db.Decimal(12, 4)
  calculatedAt            DateTime @default(now()) @map("calculated_at")

  squad  Squad  @relation(fields: [squadId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([squadId, clientId, month])
  @@map("ceremony_attributions")
}

model AnomalyFlag {
  id               Int             @id @default(autoincrement())
  clientId         Int             @map("client_id")
  squadId          Int?            @map("squad_id")
  month            DateTime        @db.Date
  roleType         RoleType?       @map("role_type")
  flagType         AnomalyFlagType @map("flag_type")
  severity         AnomalySeverity
  detectorVersion  String          @default("rules_v1") @map("detector_version") @db.VarChar(50)
  explanation      String?
  detectedAt       DateTime        @default(now()) @map("detected_at")
  resolvedAt       DateTime?       @map("resolved_at")
  resolvedBy       Int?            @map("resolved_by")
  resolutionNotes  String?         @map("resolution_notes")

  client Client @relation(fields: [clientId], references: [id])
  squad  Squad? @relation(fields: [squadId], references: [id])

  @@index([clientId, month])
  @@map("anomaly_flags")
}

model MonthlyNonBillableSummary {
  id                 Int              @id @default(autoincrement())
  personId           Int              @map("person_id")
  squadId            Int              @map("squad_id")
  month              DateTime         @db.Date
  categoryType       NonBillableType? @map("category_type")
  totalHours         Decimal          @default(0) @map("total_hours") @db.Decimal(8, 2)
  capacityHours      Decimal          @default(0) @map("capacity_hours") @db.Decimal(8, 2)
  nonbillablePct     Decimal          @default(0) @map("nonbillable_pct") @db.Decimal(6, 4)
  billableHoursLost  Decimal          @default(0) @map("billable_hours_lost") @db.Decimal(8, 2)
  priorMonthHours    Decimal?         @map("prior_month_hours") @db.Decimal(8, 2)
  monthOverMonthDelta Decimal?        @map("month_over_month_delta") @db.Decimal(8, 2)
  lastRefreshed      DateTime         @default(now()) @map("last_refreshed")

  person Person @relation(fields: [personId], references: [id])
  squad  Squad  @relation(fields: [squadId], references: [id])

  @@unique([personId, month, categoryType])
  @@index([squadId, month])
  @@map("monthly_nonbillable_summaries")
}

model NonBillableEnhancementSuggestion {
  id              Int             @id @default(autoincrement())
  personId        Int?            @map("person_id")
  squadId         Int?            @map("squad_id")
  month           DateTime        @db.Date
  suggestionType  SuggestionType  @map("suggestion_type")
  status          SuggestionStatus @default(open)
  explanation     String
  suggestedAction String          @map("suggested_action")
  suggestedHours  Decimal?        @map("suggested_hours") @db.Decimal(8, 2)
  currentHours    Decimal?        @map("current_hours") @db.Decimal(8, 2)
  detectedAt      DateTime        @default(now()) @map("detected_at")
  resolvedAt      DateTime?       @map("resolved_at")
  resolvedBy      Int?            @map("resolved_by")

  person Person? @relation(fields: [personId], references: [id])
  squad  Squad?  @relation(fields: [squadId], references: [id])

  @@index([month, status])
  @@map("nonbillable_enhancement_suggestions")
}

model MonthlyCeremonyAllocation {
  id             Int      @id @default(autoincrement())
  personId       Int      @map("person_id")
  clientId       Int      @map("client_id")
  squadId        Int?     @map("squad_id")
  month          DateTime @db.Date
  allocatedHours Decimal  @map("allocated_hours") @db.Decimal(8, 2)
  lastRefreshed  DateTime @default(now()) @updatedAt @map("last_refreshed")

  person Person @relation(fields: [personId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  squad  Squad? @relation(fields: [squadId], references: [id])

  @@unique([personId, clientId, month])
  @@map("monthly_ceremony_allocations")
}

// ─── Simulation ───────────────────────────────────────────────────────────────

model ClientSimulation {
  id                  Int       @id @default(autoincrement())
  clientId            Int?      @map("client_id")
  name                String    @default("") @db.VarChar(200)
  proposedClientName  String    @map("proposed_client_name") @db.VarChar(200)
  proposedStartMonth  DateTime  @map("proposed_start_month") @db.Date
  proposedPoolHours   Decimal   @map("proposed_pool_hours") @db.Decimal(8, 2)
  requestedBy         Int?      @map("requested_by")
  approvedAt          DateTime? @map("approved_at")
  approvedBy          Int?      @map("approved_by")
  simulationResult    String?   @map("simulation_result")
  feasible            Boolean?
  bottleneckRole      RoleType? @map("bottleneck_role")
  createdAt           DateTime  @default(now()) @map("created_at")

  client            Client?                    @relation(fields: [clientId], references: [id])
  requestedByPerson Person?                    @relation("SimRequestedBy", fields: [requestedBy], references: [id])
  lineItems         ClientSimulationLineItem[]

  @@map("client_simulations")
}

model ClientSimulationLineItem {
  id              Int             @id @default(autoincrement())
  simulationId    Int             @map("simulation_id")
  roleType        RoleType        @map("role_type")
  requestedHours  Decimal         @map("requested_hours") @db.Decimal(8, 2)
  availableHours  Decimal         @map("available_hours") @db.Decimal(8, 2)
  gapHours        Decimal         @map("gap_hours") @db.Decimal(8, 2)
  action          SimulationAction
  ftesToHire      Decimal         @default(0) @map("ftes_to_hire") @db.Decimal(4, 2)
  estimatedMarginPct Decimal?     @map("estimated_margin_pct") @db.Decimal(6, 4)

  simulation ClientSimulation @relation(fields: [simulationId], references: [id])

  @@unique([simulationId, roleType])
  @@map("client_simulation_line_items")
}
